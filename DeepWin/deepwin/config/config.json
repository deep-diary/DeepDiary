{
  "paths": {
    "root": ".",
    "output": "output",
    "models": "models",
    "data": "data",
    "logs": "logs",
    "temp": "temp",
    "userdata": "userdata",
    "configs": "configs",
    "resources": "resources"
  },
  "general": {
    "theme": "light",
    "language": "zh_CN",
    "auto_sync_interval_minutes": 60,
    "data_storage_path": "data/"
  },
  "image_processing": {
    "display": {
      "max_display_pixel": -1,
      "show_fps": true
    },
    "save": {
      "base_dir": "output/processed_images",
      "save_original": false,
      "save_processed": true,
      "subdirs": {
        "face_detection": "face_detection",
        "face_recognition": "face_recognition",
        "face_mesh": "face_mesh",
        "pose": "pose",
        "hand_gesture": "hand_gesture",
        "ocr": "ocr",
        "qr_code": "qr_code",
        "yolo": "yolo"
      }
    },
    "tracking": {
      "enable_tracking": true,
      "history_length": 30,
      "enable_kalman": true,
      "enable_mean_filter": true,
      "default_tracker": "CSRT",
      "draw_trajectory": true,
      "trajectory_colors": {
        "raw": [0, 255, 255],
        "mean": [255, 0, 255],
        "kalman": [255, 255, 0]
      },
      "kalman_filter": {
        "process_noise": 0.1,
        "measurement_noise": 10
      }
    },
    "processors": {
      "face_recognition": {
        "enabled": true,
        "draw": true,
        "save": true,
        "save_faces": true,
        "face_scale": 1.2,
        "det_thresh": 0.25,
        "det_size": [1280, 1280],
        "ctx_id": 0
      },
      "face_mesh": {
        "enabled": true,
        "draw": true,
        "save": true,
        "calibration": {
          "ref_face_width_px": 300,
          "ref_face_width_cm": 15,
          "ref_distance_cm": 50
        },
        "thresholds": {
          "eye_aspect_ratio": 0.2,
          "eye_gaze": 0.2,
          "mouth_aspect_ratio": 0.5
        },
        "tracking": {
          "enable": true,
          "use_nose_point": true,
          "error_scale": 1.0
        }
      },
      "pose": {
        "enabled": true,
        "draw": true,
        "save": true
      },
      "hand_gesture": {
        "enabled": true,
        "draw": true,
        "save": false,
        "pinch_min_distance": 20,
        "pinch_max_distance": 200
      },
      "easy_ocr": {
        "enabled": true,
        "draw": true,
        "save": true
      },
      "face_detection": {
        "enabled": true,
        "draw": true,
        "save": true,
        "min_detection_confidence": 0.5,
        "model_selection": 1
      },
      "qr_code": {
        "enabled": true,
        "draw": true,
        "save": true,
        "history_size": 10
      },
      "yolo": {
        "enabled": true,
        "draw": true,
        "save": false,
        "model_type": "yolo11n.pt",
        "conf_thresh": 0.25,
        "task": "detect",
        "track": true
      }
    }
  },
  "device_settings": {
    "deeparm_serial_port": "COM11",
    "deeparm_baud_rate": 115200,
    "deeparm_can_bustype": "virtual",
    "deeparm_dbc_path": "deeparm.dbc",
    "deepmotor_serial_port": "COM16",
    "deepmotor_baud_rate": 115200,
    "deepmotor_history_length": 100,
    "deepmotor_teaching_interval": 0.1,
    "deepmotor_trajectory_interp_freq": 50,
    "deeparm_dbc_name": "deep_arm",
    "deepmotor_can_bustype": "virtual",
    "deepmotor_dbc_name": "deep_motor",
    "deepmotor_default_pos_step": 0.1
  },
  "network": {
    "server_address": "localhost:8000",
    "mqtt_broker_host": "localhost",
    "mqtt_broker_port": 1883
  },
  "ai_settings": {
    "image_recognition_enabled": true,
    "voice_recognition_enabled": true,
    "llm_api_key": "your_llm_api_key_here"
  },
  "voice": {
    "app_id": "",
    "workspace_id": "",
    "api_key": "",
    "voice_name": "longxiaochun_v2",
    "sample_rate": 48000,
    "audio_chunk_size": 3200,
    "websocket_url": "wss://dashscope.aliyuncs.com/api-ws/v1/inference",
    "model_name": "multimodal-dialog",
    "conversation_mode": "duplex"
  },
  "database": {
    "sqlite": {
      "path": "data/sqlite/deepwin_demo.db",
      "echo": false,
      "pool_size": 10,
      "max_overflow": 20,
      "backup_path": "data/backup/",
      "log_path": "logs/"
    },
    "qdrant": {
      "local_path": "data/qdrant/demo",
      "host": "localhost",
      "port": 6333,
      "api_key": null,
      "backup_path": "data/backup/qdrant/",
      "vector_sizes": {
        "user_embeddings": 1536,
        "photo_embeddings": 512,
        "memory_embeddings": 1536
      }
    },
    "faiss": {
      "path": "data/faiss/deepwin_demo.faiss"
    }
  },
  "mcp_services": [
    {
      "id": "news_feed_mcp",
      "url": "https://api.some-news-mcp.com/v1",
      "api_key": "YOUR_NEWS_API_KEY",
      "type": "external_news"
    },
    {
      "id": "amap_maps_mcp",
      "url": "https://mcp.so/server/amap-maps/amap",
      "api_key": "fd18a18f74ff824346df1d1c7185f07f",
      "type": "external_maps"
    },
    {
      "id": "deepserver_memory_mcp",
      "url": "https://your-deepserver-ip/mcp",
      "api_key": "YOUR_DEEPSERVER_MCP_API_KEY",
      "type": "internal_memory_resource"
    }
  ],
  "test": {
    "key": "test_value"
  }
}
